{
  "name": "booktrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:browser": "node scripts/browser-check.mjs",
    "check:browser:live": "node scripts/browser-live-check.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test:sql": "node scripts/test-migration.mjs",
    "test:integration": "node scripts/test-supabase.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@electric-sql/pglite": "^0.3.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "eslint": "9.39.5",
    "globals": "^16.0.0",
    "playwright-core": "^1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.11",
    "typescript-eslint": "^8.0.0"
  }
}
